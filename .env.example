# Exchange (read-only keys are enough until you wire up live execution)
EXCHANGE_ID=coinbase
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Database
DATABASE_URL=sqlite:///./quant_trader.db
# For Postgres later: postgresql://user:password@host:5432/quant_trader

# Telegram bot (talk to @BotFather to create a bot and get a token;
# talk to @userinfobot to get your own chat_id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Symbols to track, comma separated
SYMBOLS=BTC/USD,ETH/USD
